# HakiOS fragment: the Xiaomi Mi 9T / Redmi K20 (davinci) -- what is true of this phone and of no other with the same SoC.
# Every common phone driver is left out until it has been brought over and seen working here (docs/MIGRATION.md); the
# arguments only those drivers read go with them.
CONFIG_DEVICE="davinci"

# the panel, driven by the kernel (the UEFI brings it up only now and then), two framebuffers
CONFIG_HAKIOS_RPMH=y
CONFIG_HAKIOS_DSI=y
CONFIG_BOOTARGS="panel_on=1"

# touch (GT9886 in place of the common Goodix driver) and the keys: power and volume down on the PM6150's power-on
# block, volume up on GPIO 2 of the PM6150L (all started by touchscreen=1)
CONFIG_TOUCHSCREEN=y
CONFIG_HAKIOS_GT9886=y
# CONFIG_HAKIOS_GOODIX is not set
CONFIG_HAKIOS_BUTTONS=y
CONFIG_PMIC_PON=0x008
CONFIG_PMIC_VOLUME_UP=0x4c1

# storage: read through the loader's block service (ufs=2, the common default)
CONFIG_HAKIOS_UFS=y

# not brought over yet
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_GPU is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_WIFI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
