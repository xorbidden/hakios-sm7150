From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xorbidden <xorbidden@proton.me>
Date: Thu, 29 Oct 2026 12:18:26 +0100
Subject: [PATCH] gic_v3_irq.c: the virtual timer's interrupt from /arm-io/gic
 "vtimer-intid", 27 if not said

Qualcomm's SDM845/SM8150 generation, the SM7150 among them, wires the EL1 virtual timer to PPI 3,
INTID 19, not the usual 27: on the Mi 9T no timer interrupt ever came, and the kernel stopped at its first
sleep. The loader says which in the device tree (its platform's vtimer_intid); a value outside the PPIs is
not taken. Without the property nothing changes.

Seen on the Mi 9T (hackios-xnu-kernel-davinci, 8fc6cc0 on): timer interrupts on PPI 19, SpringBoard.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xnu/files/osfmk/arm64/gic_v3_irq.c | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/xnu/files/osfmk/arm64/gic_v3_irq.c b/xnu/files/osfmk/arm64/gic_v3_irq.c
index 63ffd4b..caaa66f 100644
--- a/xnu/files/osfmk/arm64/gic_v3_irq.c
+++ b/xnu/files/osfmk/arm64/gic_v3_irq.c
@@ -72,7 +72,7 @@
 
 #define GIC_SGI_SIGNAL          0           /* cpu_signal(): another processor wants this one's attention */
 #define GIC_SGI_STOP            1           /* psci_smp_stop_here(): the system is going back to the boot loader */
-#define GIC_INTID_VTIMER        27          /* EL1 virtual timer PPI */
+#define GIC_INTID_VTIMER        27          /* EL1 virtual timer PPI, unless /arm-io/gic says otherwise */
 #define GIC_INTID_SPI_MIN       32
 #define GIC_INTID_SPURIOUS_MIN  1020
 #define GIC_SPI_MOST            48          /* attached at a time */
@@ -81,6 +81,8 @@
 static vm_offset_t gicd_base, gicr_base;
 static vm_size_t   gicr_size;
 static vm_offset_t gicr_cpu_base[MAX_CPUS]; /* each processor's redistributor frame */
+/* the virtual timer's interrupt: /arm-io/gic "vtimer-intid" (Qualcomm's SDM845/SM8150 generation: 19) */
+static uint32_t    gic_intid_vtimer = GIC_INTID_VTIMER;
 
 /*
  * Acknowledged, not yet EOI'd; 0: none. The signal between processors is interrupt 0 and reads
@@ -310,7 +312,7 @@ gic_irq_handler(__unused void *target, __unused void *refCon, __unused void *nub
 		}
 		gic_active_iar[cpu] = iar | GIC_IAR_TAKEN;
 
-		if (intid == GIC_INTID_VTIMER) {
+		if (intid == gic_intid_vtimer) {
 			/* same sequence as the FIQ path in sleh_fiq() */
 			getCpuDatap()->cpu_decrementer = -1; /* Large */
 			rtclock_intr(TRUE);
@@ -418,7 +420,7 @@ gic_v3_irq_cpu_init(void)
 {
 	int cpu = cpu_number();
 	vm_offset_t gicr;
-	uint32_t mine = 1u << GIC_INTID_VTIMER;
+	uint32_t mine;
 
 	if (gicd_base == 0) {
 		DTEntry entry;
@@ -437,6 +439,10 @@ gic_v3_irq_cpu_init(void)
 		gicd_base = ml_io_map(soc_base + reg[0], reg[1]);
 		gicr_base = ml_io_map(soc_base + reg[2], reg[3]);
 		gicr_size = reg[3];
+		if (SecureDTGetProperty(entry, "vtimer-intid", &prop, &prop_size) == kSuccess && prop_size == sizeof(uint32_t) &&
+		    *(uint32_t const *)prop >= 16 && *(uint32_t const *)prop < 32) {
+			gic_intid_vtimer = *(uint32_t const *)prop;
+		}
 		if (gicd_base == 0 || gicr_base == 0) {
 			panic("gic: cannot map the distributor/redistributor");
 		}
@@ -444,6 +450,8 @@ gic_v3_irq_cpu_init(void)
 		return;
 	}
 
+	mine = 1u << gic_intid_vtimer;
+
 	/* System-register CPU interface */
 	__builtin_arm_wsr64("ICC_SRE_EL1", __builtin_arm_rsr64("ICC_SRE_EL1") | 1);
 	__builtin_arm_isb(ISB_SY);
@@ -476,7 +484,7 @@ gic_v3_irq_cpu_init(void)
 	/* Virtual timer PPI (and those): Group 1 (IRQ), default priority, enabled */
 	gic_write32(gicr + GICR_IGROUPR0, gic_read32(gicr + GICR_IGROUPR0) | mine);
 	gic_write32(gicr + GICR_IGRPMODR0, gic_read32(gicr + GICR_IGRPMODR0) & ~mine);
-	*(volatile uint8_t *)(gicr + GICR_IPRIORITYR(GIC_INTID_VTIMER)) = GIC_PRIORITY_DEFAULT;
+	*(volatile uint8_t *)(gicr + GICR_IPRIORITYR(gic_intid_vtimer)) = GIC_PRIORITY_DEFAULT;
 	gic_write32(gicr + GICR_ISENABLER0, mine);
 
 	/* Distributor: affinity routing, Group 1 enabled (normally already so) */
@@ -502,7 +510,7 @@ gic_v3_irq_cpu_init(void)
 
 	ml_install_interrupt_handler(NULL, 0, NULL, gic_irq_handler, NULL);
 	kprintf("gic: v3, distributor %p, cpu %d's redistributor %p, virtual timer on PPI %d\n",
-	    (void *)gicd_base, cpu, (void *)gicr, GIC_INTID_VTIMER);
+	    (void *)gicd_base, cpu, (void *)gicr, gic_intid_vtimer);
 }
 
 #endif /* GENERIC_GIC_V3_IRQ */
