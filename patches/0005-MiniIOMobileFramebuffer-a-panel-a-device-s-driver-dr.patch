+/*
+ * A panel this kernel drives itself, by a device's own display driver (devices/davinci: hakios.dsi.c), can be fed
+ * from either of two framebuffers: the driver says so with hakios_panel_register(), and every frame is then drawn
+ * into the one not shown and shown when it is whole (flipSetup). Without one, the boot framebuffer as before.
+ */
+struct hakios_panel {
+	void            (*start)(void);                 /* before this driver starts (GenericARMPE): the panel up */
+	bool            (*second_buffer)(uint64_t * phys, vm_offset_t * mapped);       /* a second framebuffer, if any */
+	uint64_t        (*first_buffer)(void);          /* the boot framebuffer's physical address */
+	void            (*show)(uint64_t phys);         /* the panel sent from that one, once its transfer before is done */
+};
+extern "C" void hakios_panel_register(const struct hakios_panel * panel);
+extern "C" void hakios_panel_start(void);
+static const struct hakios_panel * gPanel;
 
 /* IOConnectCallMethod selectors of the framebuffer user client (iOS 16.5) */
 enum {
@@ -142,6 +156,8 @@ static TUNABLE(uint32_t, gRecMegabytes, "rec_mb", 480);
 static TUNABLE(uint32_t, gRecRing, "rec_ring", 0);
 static TUNABLE(uint32_t, gRecStep, "rec_step", 3);
 static TUNABLE(uint32_t, gDiff, "fb_diff", 0);
+/* boot-arg fb_flip=0: one framebuffer, drawn into while the panel is sent from it (as before; it tears) */
+static TUNABLE(uint32_t, gFlip, "fb_flip", 1);
 /*
  * Boot-arg fb_filter=0: the picture is scaled to the panel nearest neighbour, as it once was. The
  * iPhone's 1125 x 2436 on this panel's 1080 x 2400 is 45 columns and 36 rows fewer: nearest
@@ -227,7 +243,14 @@ class IOMobileFramebuffer : public IOService
 
 public:
 	IOLock *        fLock;
-	uint8_t *       fBase;                  /* the boot framebuffer: the panel */
+	uint8_t *       fBase;                  /* the boot framebuffer: the panel (with two: the one drawn into) */
+	/* two framebuffers (fb_flip): a frame drawn into the one not shown, then shown (flipSetup) */
+	bool            fFlipTried, fFlipping;
+	uint8_t *       fBuffer[2];
+	uint64_t        fBufferPhys[2];
+	unsigned        fBack;                  /* the one not shown */
+	uint32_t        fCopies, fCopiesChanged;        /* (fb_watch) layers copied, and those whose surface changed meanwhile */
+	void            flipSetup(void);
