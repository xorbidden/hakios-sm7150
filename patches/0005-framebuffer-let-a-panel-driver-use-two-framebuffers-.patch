+/*
+ * A panel this kernel drives itself, by a device's own display driver (devices/davinci: hakios.dsi.c), can be fed
+ * from either of two framebuffers: the driver says so with hakios_panel_register(), and every frame is then drawn
+ * into the one not shown and shown when it is whole (flipSetup). Without one, the boot framebuffer as before.
+ */
+struct hakios_panel {
+	void            (*start)(void);                 /* before this driver starts (GenericARMPE): the panel up */
+	bool            (*second_buffer)(uint64_t * phys, vm_offset_t * mapped);       /* a second framebuffer, if any */
+	uint64_t        (*first_buffer)(void);          /* the boot framebuffer's physical address */
+	void            (*show)(uint64_t phys);         /* the panel sent from that one, once its transfer before is done */
+};
+extern "C" void hakios_panel_register(const struct hakios_panel * panel);
+extern "C" void hakios_panel_start(void);
+static const struct hakios_panel * gPanel;
 
 /* IOConnectCallMethod selectors of the framebuffer user client (Darwin userland 16.5) */
 enum {
@@ -142,6 +156,8 @@ static TUNABLE(uint32_t, gRecMegabytes, "rec_mb", 480);
 static TUNABLE(uint32_t, gRecRing, "rec_ring", 0);
