 void
 MiniIOMobileFramebufferStart(IOService * provider)
 {
diff --git a/xnu/files/iokit/Kernel/MiniIOSurface.cpp b/xnu/files/iokit/Kernel/MiniIOSurface.cpp
index 5413c2b..a6bfd1f 100644
--- a/xnu/files/iokit/Kernel/MiniIOSurface.cpp
+++ b/xnu/files/iokit/Kernel/MiniIOSurface.cpp
@@ -747,6 +747,23 @@ surfaceUnhold(MiniIOSurface * s)
 	s->release();
 }
 
+/*
+ * The display's own use of a surface, from the swap that gives it until it has been copied to the panel
+ * (MiniIOMobileFramebuffer): the use count CoreAnimation reads (IOSurfaceIsInUse) to know which of its
+ * surfaces it may draw the next frame into. Without it, one frame in five was drawn into while being
+ * copied (2026-10-23): the tearing.
+ */
+void
+MiniIOSurfaceDisplayUse(MiniIOSurface * s, int delta)
+{
+	IOLockLock(gSurfaceLock);
+	if (delta > 0 || s->useCount[0] != 0) {
+		s->useCount[0] += delta;
+		s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+	}
+	IOLockUnlock(gSurfaceLock);
+}
+
 MiniIOSurface *
 MiniIOSurfaceCopy(uint32_t sid)
