  * has? Its stride, element height and size come from whoever made it, so they are checked here,
@@ -1060,6 +1109,9 @@ IOMobileFramebuffer::present(const uint8_t * swap)
 		uint32_t sid = swapWord(swap, SWAP_SURFACE(layer));
 
 		fSwapSurfaces[slot][layer] = sid != 0 ? MiniIOSurfaceCopy(sid) : NULL;
+		if (fSwapSurfaces[slot][layer] != NULL) {
+			MiniIOSurfaceDisplayUse(fSwapSurfaces[slot][layer], 1);      /* (until it leaves the panel: presenter) */
+		}
 	}
 	fSwapsWaiting++;
 	IOLockWakeup(fSwapLock, fSwap, true);
@@ -1100,6 +1152,7 @@ IOMobileFramebuffer::presenter(void)
 		/* the frame before is done with now, settled or not */
 		for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
 			if (surfaces[layer] != NULL) {
+				MiniIOSurfaceDisplayUse(surfaces[layer], -1);
 				MiniIOSurfaceDrop(surfaces[layer]);
 				surfaces[layer] = NULL;
 			}
@@ -1113,6 +1166,7 @@ IOMobileFramebuffer::presenter(void)
 		if (!unsettled) {
 			for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
 				if (surfaces[layer] != NULL) {
+					MiniIOSurfaceDisplayUse(surfaces[layer], -1);
 					MiniIOSurfaceDrop(surfaces[layer]);
 					surfaces[layer] = NULL;
 				}
@@ -1192,12 +1246,6 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 		}
 	}
 	shown = began;
-	/* its turn has come: the swap after it may be handed over */
-	IOLockLock(fSwapLock);
-	fSwapFirst = (fSwapFirst + 1) % SWAP_QUEUE;
-	fSwapsWaiting--;
-	IOLockWakeup(fSwapLock, &fSwapsWaiting, true);
-	IOLockUnlock(fSwapLock);
 	IOLockLock(fLock);
 	if (fLastFrame != 0) {
 		absolutetime_to_nanoseconds(began - fLastFrame, &nanos);
@@ -1216,6 +1264,18 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 		    swapWord(swap, SWAP_ID), fSwapsShown, swapWord(swap, SWAP_SURFACE(0)), swapWord(swap, SWAP_SURFACE(1)),
 		    swapWord(swap, SWAP_SURFACE(2)), swapWord(swap, SWAP_SURFACE(3)), set, swapWord(swap, SWAP_LAYERS_CLEARED));
 	}
+	if (fGraphics && !fFlipTried) {
+		flipSetup();
+	}
+	if (fFlipping) {
+		/*
+		 * The one not shown was shown two frames ago, and the panel's show() waited for that
+		 * transfer to end before it started the last one: it is free, and this copy goes on
+		 * beside the panel's transfer of the frame before. (Waiting here for that transfer as
+		 * well made one frame cost a copy and a transfer one after the other: 15 a second.)
+		 */
+		fBase = fBuffer[fBack];
+	}
 	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
 		uint32_t sid = swapWord(swap, SWAP_SURFACE(layer));
 		int32_t src[4], dst[4];
@@ -1258,12 +1318,60 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 				fGraphics = true;
 				PE_initialize_console(NULL, kPEGraphicsMode);
 			}
-			drawLayer(s, src, dst);
+			if (fFlipping && fCopies < 600) {
+				/*
+				 * Does the window server write into the surface while it is being copied? Five
+				 * rows, summed before and after (for the first 600 frames only: it costs).
+				 */
+				const uint8_t * p = s->pixels();
+				uint64_t before = 0, after = 0;
+
+				for (uint32_t row = 0; row < 5; row++) {
+					const uint64_t * w = (const uint64_t *) (p + (size_t) (s->info.height * row / 5) * s->info.bytesPerRow);
+
+					for (uint32_t i = 0; i < s->info.width / 2; i++) {
+						before += w[i] * (i + 1);
+					}
+				}
+				drawLayer(s, src, dst);
+				for (uint32_t row = 0; row < 5; row++) {
+					const uint64_t * w = (const uint64_t *) (p + (size_t) (s->info.height * row / 5) * s->info.bytesPerRow);
+
+					for (uint32_t i = 0; i < s->info.width / 2; i++) {
+						after += w[i] * (i + 1);
+					}
+				}
+				fCopies++;
+				fCopiesChanged += before != after;
+				if (fCopies == 600) {
+					IOLog("MiniIOMobileFramebuffer: of 600 layers copied, %u had their surface changed while being copied\n",
+					    fCopiesChanged);
+				}
+			} else {
+				drawLayer(s, src, dst);
+			}
 			if (layer == 0) {
 				recorded = s;   /* (recorded once the frame is in the panel's memory: see below) */
 			}
 		}
 	}
+	if (fFlipping) {
+		gPanel->show(fBufferPhys[fBack]);
+		fBack ^= 1;
+	}
+	/*
+	 * Only now, with its surfaces copied, may the swap after it be handed over: SwapEnd coming back
+	 * is the window server's word that it may draw into a surface it gave before, and with that
+	 * done at the start of the copy, one in nine frames was drawn into while it was being copied
+	 * (2026-10-23: 69 of 600) -- the tearing that was left with two framebuffers.
+	 */
+	IOLockLock(fSwapLock);
+	fSwapFirst = (fSwapFirst + 1) % SWAP_QUEUE;
+	fSwapsWaiting--;
+	fSwapCopied = swapWord(swap, SWAP_ID);
+	IOLockWakeup(fSwapLock, &fSwapsWaiting, true);
+	IOLockWakeup(fSwapLock, &fSwapCopied, false);
+	IOLockUnlock(fSwapLock);
 	drawn = mach_absolute_time();
 	if (recorded != NULL) {
 		record(recorded);
@@ -1580,11 +1688,28 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 		fOwner->present((const uint8_t *) args->structureInput);
 		return kIOReturnSuccess;
 
-	case kFBMethodSwapWait:                         /* a swap is on the screen as soon as it is made */
+	case kFBMethodSwapWait:                         /* in: the swap's number: back once its surfaces are copied */
 		if (gTouchLat) {
 			hakios_tl("tl: w %llu %#llx %#llx at %llu\n", args->scalarInputCount > 0 ? in[0] : 0,
 			    args->scalarInputCount > 1 ? in[1] : 0, args->scalarInputCount > 2 ? in[2] : 0, micros(mach_absolute_time()));
 		}
+		/*
+		 * CoreAnimation draws into a swap's surfaces again once this comes back. Back at once, it
+		 * drew into one in five while it was still being copied to the panel (2026-10-23): the
+		 * tearing that was left once the panel had two framebuffers. 50 ms at the most: a swap
+		 * that is never shown (given up in present()) does not hold the window server for good.
+		 */
+		if (args->scalarInputCount > 0 && in[0] != 0) {
+			uint32_t wanted = (uint32_t) in[0];
+			AbsoluteTime deadline;
+
+			clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+			IOLockLock(fOwner->fSwapLock);
+			while ((int32_t) (fOwner->fSwapCopied - wanted) < 0 &&
+			    IOLockSleepDeadline(fOwner->fSwapLock, &fOwner->fSwapCopied, deadline, THREAD_UNINT) != THREAD_TIMED_OUT) {
+			}
+			IOLockUnlock(fOwner->fSwapLock);
+		}
 		return kIOReturnSuccess;
 	case kFBMethodSwapSignal:
 	case kFBMethodSwapCancel:
@@ -1756,6 +1881,20 @@ MiniIOMobileFramebufferShow(const uint8_t * pixels, uint32_t width, uint32_t hei
 	}
 }
 
+extern "C" void
+hakios_panel_register(const struct hakios_panel * panel)
+{
+	gPanel = panel;
+}
+
+extern "C" void
+hakios_panel_start(void)
+{
+	if (gPanel != NULL && gPanel->start != NULL) {
+		gPanel->start();
+	}
+}
