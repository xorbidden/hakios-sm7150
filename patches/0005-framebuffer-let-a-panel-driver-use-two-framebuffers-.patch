+/*
+ * At the first picture: is the panel one that can be fed from either of two framebuffers
+ * (hakios_panel_register)? Then frames are drawn into the one not shown and shown when they are
+ * whole, and none tears. (Asked only now: the panel's frames may start after this driver does.)
+ */
+void
+IOMobileFramebuffer::flipSetup(void)
+{
+	uint64_t phys;
+	vm_offset_t second;
+
+	fFlipTried = true;
+	if (gFlip == 0 || gPanel == NULL || !gPanel->second_buffer(&phys, &second)) {
+		return;
+	}
+	fBuffer[0] = (uint8_t *) vinfo.v_baseaddr;
+	fBufferPhys[0] = gPanel->first_buffer();
+	fBuffer[1] = (uint8_t *) second;
+	fBufferPhys[1] = phys;
+	fBack = 1;
+	fFlipping = true;
+	IOLog("MiniIOMobileFramebuffer: two framebuffers, %#llx and %#llx: each frame is drawn into the one not shown, then shown\n",
+	    fBufferPhys[0], fBufferPhys[1]);
+}
+
 /*
