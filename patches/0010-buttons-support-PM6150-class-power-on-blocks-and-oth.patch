diff --git a/drivers/input/hakios.buttons.c b/drivers/input/hakios.buttons.c
index 3c9b01a..f591399 100644
--- a/drivers/input/hakios.buttons.c
+++ b/drivers/input/hakios.buttons.c
@@ -1,7 +1,12 @@
 /*
  * The buttons of the POCO X5 Pro (redwood) -- power, volume up, volume down -- as a source of
  * button records for /dev/hakios-touch (sys/hakios.input.h). Only with boot-arg buttons=1:
- * every address below belongs to this phone.
+ * every address below belongs to this phone, unless the kernel's command line names other peripherals:
+ *   pmic_pon=0xSPP         the power-on block: slave S, peripheral PP (default 0x013, the PMK8350's)
+ *   pmic_volume_up=0xSPP   the GPIO that is volume up (default 0x18d, GPIO6 of the PM7325)
+ * A PM6150-generation power-on block (subtype 1 to 5, as on the SM7150's Mi 9T: 0x008, volume up 0x4c1) has
+ * the keys in bits 0 and 1 of its status, not 7 and 6 (Linux drivers/input/misc/pm8941-pwrkey.c, Qualcomm's
+ * qpnp-power-on.c): which kind it is is taken from the subtype it reports.
  *
  * None of the three is a pin of the SoC. They are inputs of two of the power management chips:
  *   power        KPDPWR_N of the power-on block ("PON") of the PMK8350
@@ -130,9 +135,11 @@ struct peripheral {
 	uint16_t        id;             /* slave << 8 | peripheral: the high byte of its register addresses */
 	uint16_t        channel;
 	bool            found;
+	uint8_t         subtype;        /* as it says (identify) */
 };
-static struct peripheral pon = { .name = "the PMK8350's power-on block", .id = 0x013 };          /* registers 0x1300 of slave 0 */
-static struct peripheral pin = { .name = "GPIO6 of the PM7325", .id = 0x18d };                   /* registers 0x8d00 of slave 1 */
+static struct peripheral pon = { .name = "the power-on block", .id = 0x013 };    /* default: the PMK8350's, 0x1300 of slave 0 */
+static struct peripheral pin = { .name = "the volume-up pin", .id = 0x18d };     /* default: GPIO6 of the PM7325, 0x8d00 of slave 1 */
+static uint8_t pon_kpdpwr, pon_resin;   /* the keys' bits in the power-on block's status (by its subtype) */
 
 /* How the reads have gone: said once a minute. */
 static struct {
@@ -229,9 +236,13 @@ find_channel(struct peripheral *p, uint32_t channels)
 
 /* the power-on block, of the kind that is split in two ("generation 3"): this is its half for the operating system */
 #define PON_TYPE                0x01
-#define PON_SUBTYPE_HLOS        0x09
-#define PON_KPDPWR              0x80            /* in the status and in the interrupt registers */
+#define PON_SUBTYPE_PRIMARY     0x01            /* 1 to 5: the PM8941's kind up to "gen2" (the PM6150's) */
+#define PON_SUBTYPE_GEN2_LAST   0x05
+#define PON_SUBTYPE_HLOS        0x09            /* "gen3", the PMK8350's */
+#define PON_KPDPWR              0x80            /* in the status and in the interrupt registers ("gen3") */
 #define PON_RESIN               0x40
+#define PON_KPDPWR_GEN2         0x01            /* ... and in the older kind */
+#define PON_RESIN_GEN2          0x02
 
 /* a GPIO of the low or medium voltage kind */
 #define GPIO_TYPE               0x10
@@ -318,8 +329,8 @@ buttons_poll(void)
 	if (power.usable || volume_down.usable) {
 		problem = spmi_read(&pon, REG_RT_STATUS, &status, 1);
 		if (problem == NULL) {
-			button_look(&power, status & PON_KPDPWR);
-			button_look(&volume_down, status & PON_RESIN);
+			button_look(&power, status & pon_kpdpwr);
+			button_look(&volume_down, status & pon_resin);
 		} else if (said < 8) {
 			said++;
 			printf("buttons: reading %s: %s\n", pon.name, problem);
@@ -338,7 +349,7 @@ buttons_poll(void)
 
 /* Step 3: is each peripheral what the registers above are those of? */
 static bool
-identify(const struct peripheral *p, uint8_t type, uint8_t subtype_from, uint8_t subtype_to)
+identify(struct peripheral *p, uint8_t type, uint8_t subtype_from, uint8_t subtype_to)
 {
 	const char *problem;
 	uint8_t is[2];
@@ -358,6 +369,7 @@ identify(const struct peripheral *p, uint8_t type, uint8_t subtype_from, uint8_t
 		    subtype_from, subtype_to);
 		return false;
 	}
+	p->subtype = is[1];
 	return true;
 }
 
@@ -368,7 +380,8 @@ pon_inputs(void)
 	const char *problem;
 	uint8_t r[8], more[2];
 
-	printf("buttons: next: read the status and the interrupt setup of %s (registers 0x1310 to 0x1319)\n", pon.name);
+	printf("buttons: next: read the status and the interrupt setup of %s (registers 0x%02x10 to 0x%02x19)\n", pon.name,
+	    pon.id & 0xff, pon.id & 0xff);
 	problem = spmi_read(&pon, REG_RT_STATUS, r, 8);
 	if (problem == NULL) {
 		problem = spmi_read(&pon, REG_INT_LATCHED, more, 2);
@@ -378,12 +391,12 @@ pon_inputs(void)
 		return;
 	}
 	printf("buttons: power-on block: status %#x (power %s, volume down %s); interrupts: edge %#x, high %#x, low %#x, "
-	    "enabled %#x, latched %#x, pending %#x\n", r[0], (r[0] & PON_KPDPWR) ? "HELD" : "released",
-	    (r[0] & PON_RESIN) ? "HELD" : "released", r[REG_INT_SET_TYPE - REG_RT_STATUS], r[REG_INT_POLARITY_HIGH - REG_RT_STATUS],
+	    "enabled %#x, latched %#x, pending %#x\n", r[0], (r[0] & pon_kpdpwr) ? "HELD" : "released",
+	    (r[0] & pon_resin) ? "HELD" : "released", r[REG_INT_SET_TYPE - REG_RT_STATUS], r[REG_INT_POLARITY_HIGH - REG_RT_STATUS],
 	    r[REG_INT_POLARITY_LOW - REG_RT_STATUS], r[REG_INT_ENABLED - REG_RT_STATUS], more[0], more[1]);
 	power.usable = volume_down.usable = true;
-	power.last = r[0] & PON_KPDPWR;
-	volume_down.last = r[0] & PON_RESIN;
+	power.last = r[0] & pon_kpdpwr;
+	volume_down.last = r[0] & pon_resin;
 }
 
 /* Step 4 for the pin: it is volume up only if it is an input with a pull-up, and switched on. */
@@ -394,7 +407,8 @@ pin_input(void)
 	uint8_t c[8], status = 0;
 	unsigned mode, pull;
 
-	printf("buttons: next: read the setup and the level of %s (registers 0x8d40 to 0x8d47, 0x8d10)\n", pin.name);
+	printf("buttons: next: read the setup and the level of %s (registers 0x%02x40 to 0x%02x47, 0x%02x10)\n", pin.name,
+	    pin.id & 0xff, pin.id & 0xff, pin.id & 0xff);
 	problem = spmi_read(&pin, GPIO_REG_MODE, c, 8);
 	if (problem == NULL) {
 		problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
@@ -455,6 +469,17 @@ buttons_thread(void *parameter, __unused wait_result_t result)
 	}
 
 	printf("buttons: step 2: look through the arbiter's table for the channels of the two peripherals\n");
+	{
+		uint32_t id;
+
+		if (PE_parse_boot_argn("pmic_pon", &id, sizeof(id)) && id != 0 && id <= 0xfff) {
+			pon.id = (uint16_t)id;
+		}
+		if (PE_parse_boot_argn("pmic_volume_up", &id, sizeof(id)) && id != 0 && id <= 0xfff) {
+			pin.id = (uint16_t)id;
+		}
+	}
+	printf("buttons: the power-on block is peripheral %#x, volume up %#x (slave << 8 | peripheral)\n", pon.id, pin.id);
 	find_channel(&pon, channels);
 	find_channel(&pin, channels);
 	if (steps < 3) {
@@ -462,7 +487,17 @@ buttons_thread(void *parameter, __unused wait_result_t result)
 	}
 
 	printf("buttons: step 3: the first transfers on the SPMI bus\n");
-	pon_known = identify(&pon, PON_TYPE, PON_SUBTYPE_HLOS, PON_SUBTYPE_HLOS);
+	pon_known = identify(&pon, PON_TYPE, PON_SUBTYPE_PRIMARY, PON_SUBTYPE_HLOS);
+	if (pon_known && pon.subtype <= PON_SUBTYPE_GEN2_LAST) {
+		pon_kpdpwr = PON_KPDPWR_GEN2;
+		pon_resin = PON_RESIN_GEN2;
+	} else if (pon_known && pon.subtype == PON_SUBTYPE_HLOS) {
+		pon_kpdpwr = PON_KPDPWR;
+		pon_resin = PON_RESIN;
+	} else if (pon_known) {
+		printf("buttons: ... a power-on block of a kind (%#x) whose keys this driver does not know: left alone\n", pon.subtype);
+		pon_known = false;
+	}
 	pin_known = identify(&pin, GPIO_TYPE, GPIO_SUBTYPE_LV, GPIO_SUBTYPE_MV_VIN3);
 	if (steps < 4) {
 		goto out;
