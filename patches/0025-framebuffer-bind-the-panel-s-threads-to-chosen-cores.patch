diff --git a/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp b/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
index 96f24ef..51c1e0b 100644
--- a/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
+++ b/xnu/files/iokit/Kernel/MiniIOMobileFramebuffer.cpp
@@ -199,6 +199,37 @@ static TUNABLE(uint32_t, gThreads, "fb_threads", 3);
 static TUNABLE(uint32_t, gThreadPriority, "fb_pri", 92);
 extern "C" kern_return_t kernel_thread_start_priority(thread_continue_t continuation, void * parameter, integer_t priority,
     thread_t * new_thread);
+/*
+ * Boot-arg fb_cores=MASK: the presenter and its helpers each bound to a core of MASK (by cpu-id: the boot core is 0,
+ * then the big ones, then the small; xnuloader/loader.c), the presenter to the first, helper i to the (i+2)-th; 0 (the
+ * default) leaves them to the scheduler. On a phone with two big cores (davinci: fb_cores=0xfc fb_threads=6) the
+ * scaling at fb_pri took both of them for 4 to 7 ms of every frame, and the window server, put off onto the small
+ * cores, drew there in 13 ms instead of 7 (touch_lat=1, 2 November): bound to the small ones, it leaves the big ones
+ * to the drawing.
+ */
+static TUNABLE(uint32_t, gCores, "fb_cores", 0);
+extern "C" processor_t cpu_to_processor(int cpu);
+extern "C" processor_t thread_bind(processor_t processor);
+extern "C" wait_result_t thread_block(thread_continue_t continuation);
+extern "C" int ml_get_max_cpu_number(void);
+
+/* the calling thread onto the n-th core of fb_cores (n from 0), if there is one */
+static void
+panel_thread_bind(unsigned n)
+{
+	for (int cpu = 0; cpu <= ml_get_max_cpu_number() && cpu < 32; cpu++) {
+		if ((gCores & (1u << cpu)) == 0 || n-- != 0) {
+			continue;
+		}
+		processor_t processor = cpu_to_processor(cpu);
+
+		if (processor != PROCESSOR_NULL) {
+			thread_bind(processor);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		return;
+	}
+}
 
 /* a thread of the panel's, at fb_pri */
 static kern_return_t
@@ -874,6 +905,7 @@ IOMobileFramebuffer::helperMain(void * self, wait_result_t result __unused)
 	IOLockLock(fb->fHelperLock);
 	index = fb->fHelpersStarted++;
 	IOLockUnlock(fb->fHelperLock);
+	panel_thread_bind(index + 1);
 	for (;;) {
 		const RowJob * job;
 		int32_t rows, y0, y1;
@@ -1121,6 +1153,7 @@ IOMobileFramebuffer::present(const uint8_t * swap)
 void
 IOMobileFramebuffer::presenterMain(void * self, wait_result_t result __unused)
 {
+	panel_thread_bind(0);
 	((IOMobileFramebuffer *) self)->presenter();
 }
 
