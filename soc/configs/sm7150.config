# HakiOS fragment: the Qualcomm SM7150 family (Snapdragon 730/730G/732G, "sdmmagpie") -- what is true of the SoC, whatever
# phone it is in. Eight cores, the biggest are 6 and 7 (the kernel runs on 7, the loader keeps 0); the GIC and the timer's
# PPI (19) are the loader's platform's (xnuloader/loader.c, platform_davinci).
CONFIG_SOC="sm7150"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
# the drivers of this SoC family: a device with it gets them from here
# CONFIG_HAKIOS_CPUFREQ is not set
CONFIG_HAKIOS_CPUFREQ_OSM=y
# the GPU: the common Adreno driver for HakiosGPU and the address allocator, with the A618 as its backend
CONFIG_HAKIOS_ADRENO=y
CONFIG_HAKIOS_A618=y
